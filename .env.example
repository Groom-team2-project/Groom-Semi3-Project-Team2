# Database
# 호스트에서 백엔드를 직접 실행할 때 사용하는 주소입니다.
DB_URL=jdbc:mysql://localhost:3306/moigo?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# 첫 EC2 통합 배포에서는 local-db 프로필과 Compose 내부 mysql 호스트를 사용합니다.
COMPOSE_PROFILES=local-db
COMPOSE_DB_URL=jdbc:mysql://mysql:3306/moigo?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=moigo
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
JPA_DDL_AUTO=validate

# JWT
# 운영 환경에서는 충분히 길고 무작위인 값으로 교체하세요.
JWT_SECRET=change-me-to-a-long-random-secret-key-for-production
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=1209600

# OAuth cookie
# 로컬 HTTP에서는 false, 운영 HTTPS에서는 true로 설정하세요.
OAUTH_COOKIE_SECURE=false

# Kakao OAuth
KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao/callback

# Server
SERVER_PORT=8080
APP_PORT=8080
IMAGE_TAG=latest

# S3
AWS_REGION=us-east-1
S3_BUCKET_NAME=change-me-to-the-full-bucket-name
# CloudFront 기본 도메인 또는 연결한 이미지 전용 도메인입니다. 마지막 /는 제외하세요.
S3_PUBLIC_URL=https://change-me.cloudfront.net

# Docker Compose가 prod 프로필을 자동으로 활성화합니다.
# RDS 전환 시 COMPOSE_PROFILES 값을 비우고 COMPOSE_DB_URL의 호스트를 RDS 엔드포인트로 바꿉니다.
# COMPOSE_PROFILES=
# COMPOSE_DB_URL=jdbc:mysql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:3306/moigo?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=true

KAKAO_REST_API_KEY=change-me